#############################
# Ignore OS generated files #
#############################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
*[Tt]humbs.db
*.Trashes
.vscode

#############################
# Ignore SASS cache / logs #
#############################
*.sass-cache
*.log
npm-debug.log*
yarn-debug.log*

#############################
# Ignore everything in the root except "wp-content" and docs #
#############################
/*
!.gitignore
!README.md
!wp-content/

#############################
# Ignore everything in the "wp-content" directory, except the "themes" directory.
#############################
wp-content/*
!wp-content/themes/

# Node modules & bower inside theme
wp-content/themes/nova/node_modules/
wp-content/themes/nova/_/node_modules/
wp-content/themes/nova/_/bower/

#############################
# Ignore everything in the "themes" directory, except "nova"
#############################
wp-content/themes/*
!wp-content/themes/nova/
